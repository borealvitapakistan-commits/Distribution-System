# Example only. Never copy real credentials into this file or commit .env.
# Vercel: enter these individually in Project Settings > Environment Variables.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# Supabase > Connect: transaction pooler (port 6543) for the app.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Session pooler (port 5432), used only by the GitHub Actions release script.
DATABASE_MIGRATION_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DB_TRANSACTION_POOLER=True
DB_POOL_MIN=0
DB_POOL_MAX=1

# Private Supabase Storage bucket. Copy endpoint/region/keys from Storage > S3.
USE_S3_STORAGE=True
S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION_NAME=your-supabase-region
S3_BUCKET_NAME=distribution-media
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key

# Needed for password reset emails. Use your SMTP provider's values.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Boreal Vita <accounts@example.com>

# Optional integrations; leave blank/off until configured.
SLACK_WEBHOOK_URL=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_INVENTORY_SYNC=False
SHOPIFY_LOCATION_ID=

# Local development overrides: DEBUG=True, ALLOWED_HOSTS=localhost,127.0.0.1,
# USE_S3_STORAGE=False, DB_TRANSACTION_POOLER=False, and your existing DB URL.
